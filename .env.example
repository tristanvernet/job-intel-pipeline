# Copy to .env, uncomment what you change, and export it before starting:
#   set -a; . ./.env; set +a
# Relative paths resolve against the repo root. Empty values use the default.
# JOBINTEL_DB_PATH=jobs.db
# JOBINTEL_PROFILE_PATH=profile.json
# JOBINTEL_SCHEDULE_CONFIG_PATH=schedule_config.json
# JOBINTEL_LOCK_PATH=~/.jobintel.lock
# JOBINTEL_HOST=127.0.0.1
# JOBINTEL_PORT=8000
